# ==============================================================
# ZedBoard / 通用 XC7Z020CLG484-2 标准 XDC 约束
# 适配你的 FS_Design_wrapper.v
# 仅约束 DDR + FIXED_IO，无多余引脚
# ==============================================================

# --------------------------
# 1. 时钟约束
# --------------------------
create_clock -period 10.000 -name sys_clk -waveform {0.000 5.000} [get_ports FIXED_IO_ps_clk]

# --------------------------
# 2. 物理引脚约束 (Zynq7020clg484)
